# --- Obligatorias (Etapa 2) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<clave anon/publishable>
CORS_ORIGINS=http://localhost:3000

# --- Opcionales ---
APP_ENV=development
LOG_LEVEL=INFO
# Solo si el proyecto usa el secreto HS256 legado; si no, se valida con JWKS.
SUPABASE_JWT_SECRET=
SP_TIMEOUT_SECONDS=30
SP_READ_RETRIES=2

# --- Solo backend, nunca en el frontend (se usa desde la Etapa 3: ingesta y Storage) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Etapa 3: embeddings e ingesta ---
EMBEDDING_PROVIDER=voyage        # voyage | fake (fake solo desarrollo/tests)
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
MAX_UPLOAD_MB=20
INGESTION_BATCH_SIZE=50

# --- Etapa 4: Claude y RAG ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5     # alternativa más rápida/económica: claude-sonnet-5-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=4096
CLAUDE_FALLBACKS=true
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.35
RAG_HISTORY_MESSAGES=6
CHAT_RATE_LIMIT_PER_MINUTE=20

# DATABASE_URL no se usa: el acceso a datos es por Supabase RPC (ver docs, ADR-01).
